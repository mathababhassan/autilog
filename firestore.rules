rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    function isLinkedTherapist(childId) {
      return exists(/databases/$(database)/documents/therapists/$(request.auth.uid)/patients/$(childId));
    }

    function canReadChildData(parentId, childId) {
      return isAuth() && (isOwner(parentId) || isLinkedTherapist(childId));
    }

    function isValidRating(value) {
      return value is int && value >= 1 && value <= 5;
    }

    function isValidTimeMinutes(value) {
      return value is int && value >= 0 && value <= 1439;
    }

    function isValidStringList(list, minSize) {
      return list is list && list.size() >= minSize;
    }

    function positiveMomentPayloadValid(data) {
      return data.keys().hasAll([
          'date', 'time', 'antecedentDescription', 'setting',
          'behaviorDescription', 'behaviorTypes',
          'positiveBehaviorRating', 'consequenceDescription',
          'effectiveness', 'createdAt', 'updatedAt', 'type'
        ])
        && data.type == 'positiveMoment'
        && data.date is timestamp
        && isValidTimeMinutes(data.time)
        && data.antecedentDescription is string
        && data.antecedentDescription.size() > 0
        && data.antecedentDescription.size() <= 4000
        && data.setting is string
        && data.setting.size() > 0
        && data.behaviorDescription is string
        && data.behaviorDescription.size() > 0
        && data.behaviorDescription.size() <= 4000
        && isValidStringList(data.behaviorTypes, 1)
        && isValidRating(data.positiveBehaviorRating)
        && data.consequenceDescription is string
        && data.consequenceDescription.size() > 0
        && data.consequenceDescription.size() <= 4000
        && isValidRating(data.effectiveness)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && (!('videoUrl' in data) || data.videoUrl == null || data.videoUrl is string);
    }

    // ── Users & Children ──────────────────────────────────────────────────────
    match /users/{uid} {
      allow read, write: if isAuth() && isOwner(uid);

      match /children/{childId} {
        allow read, write: if isAuth() && isOwner(uid);

        match /logs/{logId} {
          allow create, read, update, delete: if isAuth() && isOwner(uid);
          allow read: if isAuth() && isLinkedTherapist(childId);
        }

        match /linkedTherapists/{therapistId} {
          allow read: if isAuth() && isOwner(uid);
        }

        match /aiInsights/{doc} {
          allow read: if isAuth() && (isOwner(uid) || isLinkedTherapist(childId));
        }
      }
    }

    // ── Parents & Children ───────────────────────────────────────────────────
    match /parents/{uid} {
      allow read: if isAuth() && (isOwner(uid)
        || exists(/databases/$(database)/documents/therapists/$(request.auth.uid)));
      allow write: if isAuth() && isOwner(uid);

      match /children/{childId} {
        allow read: if canReadChildData(uid, childId);
        allow write: if isAuth() && isOwner(uid);

        match /dailySummaries/{summaryId} {
          allow read: if canReadChildData(uid, childId);
          allow write: if isAuth() && isOwner(uid);

          // ── Comments on Daily Summaries ───────────────────────────────────
          match /comments/{commentId} {
            allow read: if canReadChildData(uid, childId);
            allow create: if isAuth() && isLinkedTherapist(childId);
            allow update, delete: if isAuth() && isLinkedTherapist(childId)
              && resource.data.therapistId == request.auth.uid;
          }
        }

        match /aiInsights/{doc} {
          allow read: if canReadChildData(uid, childId);
          allow write: if isAuth() && isOwner(uid);
        }
        
        match /incidents/{incidentId} {
          allow read: if canReadChildData(uid, childId);
          allow write: if isAuth() && isOwner(uid);

          // ── Comments on Incidents ─────────────────────────────────────────
          match /comments/{commentId} {
            allow read: if canReadChildData(uid, childId);
            allow create: if isAuth() && isLinkedTherapist(childId);
            allow update, delete: if isAuth() && isLinkedTherapist(childId)
              && resource.data.therapistId == request.auth.uid;
          }
        }

        match /positiveMoments/{momentId} {
          allow read: if canReadChildData(uid, childId);
          allow create: if isAuth() && isOwner(uid)
            && positiveMomentPayloadValid(request.resource.data);
          allow update: if isAuth() && isOwner(uid)
            && positiveMomentPayloadValid(request.resource.data)
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.type == resource.data.type;
          allow delete: if isAuth() && isOwner(uid);
        }

        // ── Tracking Questions ────────────────────────────────────────────────
        // Created and managed by the linked therapist per child.
        // Parent reads them to render dynamically in the daily summary form.
        match /trackingQuestions/{questionId} {
          allow read: if canReadChildData(uid, childId);
          allow create, update: if isAuth() && isLinkedTherapist(childId);
          allow delete: if isAuth() && isLinkedTherapist(childId);
        }

        match /linkedTherapists/{therapistId} {
          allow read: if canReadChildData(uid, childId);
          allow create: if isAuth() && request.auth.uid == therapistId;
          allow delete: if isAuth()
            && (isOwner(uid) || request.auth.uid == therapistId);
        }

        // Denormalized activity feed — written by Cloud Functions only.
        match /activityLogs/{logId} {
          allow read: if canReadChildData(uid, childId);
          allow write: if false;
        }
      }

      // ── Notifications ────────────────────────────────────────────────────────
      // Records are written by Cloud Functions only. The owner may flip `read`
      // (and nothing else) and may delete to dismiss.
      match /notifications/{notifId} {
        allow read: if isAuth() && isOwner(uid);
        allow update: if isAuth() && isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
        allow delete: if isAuth() && isOwner(uid);
        allow create: if false;
      }
    }

    // ── Therapists ────────────────────────────────────────────────────────────
    match /therapists/{therapistId} {
      allow read: if isAuth();
      allow write: if isAuth() && isOwner(therapistId);

      match /pendingRequests/{requestId} {
        allow read, delete: if isAuth() && isOwner(therapistId);
      }

      match /patients/{childId} {
        allow read: if isAuth() && isOwner(therapistId);
        allow create: if isAuth() && isOwner(therapistId);
        allow update: if isAuth()
          && (isOwner(therapistId) || resource.data.parentId == request.auth.uid);
        allow delete: if isAuth()
          && (isOwner(therapistId) || resource.data.parentId == request.auth.uid);

        match /feed/{momentId} {
          allow read: if isAuth() && isOwner(therapistId);
          allow write: if false;
        }
      }

      // ── Notifications ────────────────────────────────────────────────────────
      // Records are written by Cloud Functions only. The owner may flip `read`
      // (and nothing else) and may delete to dismiss.
      match /notifications/{notifId} {
        allow read: if isAuth() && isOwner(therapistId);
        allow update: if isAuth() && isOwner(therapistId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
        allow delete: if isAuth() && isOwner(therapistId);
        allow create: if false;
      }
    }

    // ── Patient link requests ─────────────────────────────────────────────────
    match /linkRequests/{requestId} {
      allow read: if isAuth()
        && (resource.data.parentId == request.auth.uid
            || resource.data.therapistEmail == request.auth.token.email);
      allow create: if isAuth()
        && request.resource.data.parentId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if isAuth()
        && resource.data.therapistEmail == request.auth.token.email
        && request.resource.data.parentId == resource.data.parentId
        && request.resource.data.childId == resource.data.childId
        && request.resource.data.therapistEmail == resource.data.therapistEmail;
      allow delete: if isAuth()
        && (resource.data.parentId == request.auth.uid
            || resource.data.therapistEmail == request.auth.token.email);
    }

    // ── Sessions ──────────────────────────────────────────────────────────────
    match /sessions/{sessionId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update, delete: if isAuth();
    }

  }
}
