rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    function isLinkedTherapist(childId) {
      return exists(/databases/$(database)/documents/therapists/$(request.auth.uid)/patients/$(childId));
    }

    // ── Users & Children ──────────────────────────────────────────────────────
    match /users/{uid} {
      allow read, write: if isAuth() && isOwner(uid);

      match /children/{childId} {
        allow read, write: if isAuth() && isOwner(uid);

        match /logs/{logId} {
          allow create, read, update, delete: if isAuth() && isOwner(uid);
          allow read: if isAuth() && isLinkedTherapist(childId);
        }

        // Written by Cloud Function (admin SDK) on link accept.
        // Parent can read to know which therapists are linked.
        match /linkedTherapists/{therapistId} {
          allow read: if isAuth() && isOwner(uid);
        }

        // Written by Cloud Function (admin SDK) after 7 daily summaries.
        // Parent can read; linked therapist can read (for T-10/T-11 patient detail screens).
        match /aiInsights/{doc} {
          allow read: if isAuth() && (isOwner(uid) || isLinkedTherapist(childId));
        }
      }
    }

    // ── Parents & Children ───────────────────────────────────────────────────
    match /parents/{parentId} {
      allow read, write: if isAuth() && isOwner(parentId);
      // Therapists read parent name for pending request display cards.
      allow read: if isAuth();

      match /children/{childId} {
        allow read, write: if isAuth() && isOwner(parentId);
        // Therapist reads child data for pending and accepted patient cards.
        allow read: if isAuth();
        // Therapist can accept (link themselves) or remove (unlink themselves).
        allow update: if isAuth() && (
          request.resource.data.linkedTherapistId == request.auth.uid ||
          resource.data.linkedTherapistId == request.auth.uid
        );

        match /incidents/{incidentId} {
          allow read, write: if isAuth() && isOwner(parentId);
          allow read: if isAuth() && isLinkedTherapist(childId);
        }
      }
    }

    // ── Link Requests ─────────────────────────────────────────────────────────
    match /linkRequests/{requestId} {
      // Parent: read and delete their own requests; create new ones.
      allow read, delete: if isAuth() && resource.data.parentId == request.auth.uid;
      allow create: if isAuth() && request.resource.data.parentId == request.auth.uid;
      // Therapist: read and update status of requests addressed to them.
      allow read, update: if isAuth() &&
        request.auth.token.email == resource.data.therapistEmail;
    }

    // ── Therapists ────────────────────────────────────────────────────────────
    match /therapists/{therapistId} {
      allow read, write: if isAuth() && isOwner(therapistId);
      // Parents read therapist name/clinic when a child is linked to them.
      // Mirrors the symmetric rule on /parents that lets therapists read parent names.
      allow read: if isAuth();

      match /pendingRequests/{requestId} {
        allow read, delete: if isAuth() && isOwner(therapistId);
      }

      // Written by PatientRepository.acceptLinkRequest — powers isLinkedTherapist().
      match /patients/{childId} {
        allow read, delete: if isAuth() && isOwner(therapistId);
        allow create: if isAuth() && isOwner(therapistId);
        // Parent can delete their own child's patient record when revoking access.
        allow delete: if isAuth() && resource.data.parentId == request.auth.uid;
      }
    }

    // ── Collection group: lets fetchAcceptedPatients query across all parents ──
    match /{path=**}/children/{childId} {
      allow read: if isAuth() && resource.data.linkedTherapistId == request.auth.uid;
    }

  }
}
