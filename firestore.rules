rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    function isLinkedTherapist(childId) {
      return exists(/databases/$(database)/documents/therapists/$(request.auth.uid)/patients/$(childId));
    }

    // ── Users & Children ──────────────────────────────────────────────────────
    match /users/{uid} {
      allow read, write: if isAuth() && isOwner(uid);

      match /children/{childId} {
        allow read, write: if isAuth() && isOwner(uid);

        match /logs/{logId} {
          allow create, read, update, delete: if isAuth() && isOwner(uid);
          allow read: if isAuth() && isLinkedTherapist(childId);
        }

        // Written by Cloud Function (admin SDK) on link accept.
        // Parent can read to know which therapists are linked.
        match /linkedTherapists/{therapistId} {
          allow read: if isAuth() && isOwner(uid);
        }
      }
    }

    // ── Therapists ────────────────────────────────────────────────────────────
    match /therapists/{therapistId} {
      allow read, write: if isAuth() && isOwner(therapistId);

      // Pending link requests sent by parents.
      // Written by Cloud Function (admin SDK). Therapist can read/delete their own.
      match /pendingRequests/{requestId} {
        allow read, delete: if isAuth() && isOwner(therapistId);
      }

      // Active patient links. Written by Cloud Function on accept.
      // Therapist can read and delete (remove patient).
      match /patients/{childId} {
        allow read, delete: if isAuth() && isOwner(therapistId);
      }
    }

  }
}